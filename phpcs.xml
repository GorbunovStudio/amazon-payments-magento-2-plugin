<?xml version="1.0"?>
<ruleset name="magento2.Amazon">

    <arg name="basepath" value="." />
    <arg name="extensions" value="php,phtml" />
    <ini name="xdebug.mode" value="off" />
    <file>.</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>generated/*</exclude-pattern>

    <rule ref="Magento2">
        <!-- sniffs to exclude -->
        <exclude name="Magento2.Annotation.MethodAnnotationStructure" />
        <exclude name="Magento2.Commenting.ClassPropertyPHPDocFormatting" />
    </rule>

    <rule ref="Generic.Files.LineLength"> <!-- rule to override -->
        <properties>
            <property name="lineLimit" value="120" /> <!-- maximum line length -->
        </properties>
    </rule>

</ruleset>